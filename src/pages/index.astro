---
import { Image } from 'astro:assets';
import appIcon from '../assets/app-icon.png';
import NumberedSection from '../components/NumberedSection.astro';
import { coverage, guarantees, mockTiles, ratings } from '../data/landing';
import { SITE } from '../data/site';
import Base from '../layouts/Base.astro';
---

<Base
  title="Reclaim — clean the space your dev tools quietly keep"
  description="A free, open-source macOS app that finds developer caches — Xcode, Android Studio, AI tools, package managers — explains what each one is, and removes only what you choose. Nothing leaves your Mac."
  maxWidth={1120}
  headerCta
>
  <div class="container">
    <p class="eyebrow reveal" style="--i: 0">
      <span class="dot" aria-hidden="true"></span>
      <span class="label">Free + open source for macOS</span>
    </p>
    <h1 class="reveal" style="--i: 1">Reclaim the space your dev tools quietly keep.</h1>
    <div class="intro">
      <p class="lede reveal" style="--i: 2">
        Every toolchain leaves something behind: build caches, indexes, runtimes, model weights.
        Reclaim finds them, explains what each one is, and removes only what you choose. Nothing
        ever leaves your Mac.
      </p>
      <p class="actions reveal" style="--i: 3">
        <a class="button" href={SITE.download}>Download for macOS</a>
        <a class="button ghost" href={SITE.repo}>View source <span aria-hidden="true">↗</span></a>
      </p>
    </div>
    <p class="meta reveal" style="--i: 4">Universal binary · macOS 15+ · MIT licensed · No payment, ever</p>

    <div
      class="window reveal"
      style="--i: 5"
      role="img"
      aria-label="The Reclaim overview window after a scan: a progress ring showing 220.4 GB found, next to the six largest items, led by derived data at 34.2 GB."
    >
      <div class="chrome">
        <span class="dots"><span></span><span></span><span></span></span>
        <span class="window-title">reclaim · overview</span>
      </div>
      <div class="window-body">
        <div class="ring">
          <svg viewBox="0 0 100 100">
            <circle cx="50" cy="50" r="44"></circle>
            <circle class="arc" cx="50" cy="50" r="44"></circle>
          </svg>
          <span class="total"><span class="gb">220.4</span><span class="unit">GB found</span></span>
        </div>
        <ul class="tiles">
          {
            mockTiles.map(({ name, size, share }) => (
              <li style={`--share: ${share}%`}>
                <span class="name">{name}</span>
                <span class="size">{size}</span>
                <span class="bar" />
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <NumberedSection index="01" title="Coverage">
      <div class="split">
        <h3>A curated catalogue, not a disk crawler.</h3>
        <p>
          Reclaim knows where each tool keeps its scratch data and measures those locations
          directly, instead of guessing from file sizes across your whole drive. The catalogue
          grows with every release, and anyone can add to it.
        </p>
      </div>
      <ul class="coverage">
        {
          coverage.map(({ name, detail }, i) => (
            <li>
              <span class="num" aria-hidden="true">{`0${i + 1}`}</span>
              <span class="name">{name}</span>
              <p>{detail}</p>
            </li>
          ))
        }
      </ul>
    </NumberedSection>

    <NumberedSection index="02" title="Safety">
      <div class="safety">
        <div class="safety-copy">
          <h3>Every item is rated before you touch it.</h3>
          <p>
            Nothing is removed without confirmation, and everything goes to the Trash by default.
            Only Safe items are preselected unless you explicitly opt Caution in.
          </p>
        </div>
        <ul class="ratings">
          {
            ratings.map(({ label, tone, text }) => (
              <li>
                <span class:list={['badge', tone]}>{label}</span>
                <p>{text}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </NumberedSection>

    <NumberedSection index="03" title="Guarantees">
      <h3 class="nevers-title">What Reclaim will not do.</h3>
      <ul class="nevers">
        {
          guarantees.map(({ title, text }, i) => (
            <li>
              <span class="num" aria-hidden="true">{`0${i + 1}`}</span>
              <div>
                <span class="name">{title}</span>
                <p>{text}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </NumberedSection>

    <section class="download" id="download" aria-labelledby="download-title">
      <div class="download-inner">
        <Image src={appIcon} alt="" width={72} height={72} densities={[1, 2]} />
        <h2 id="download-title">Find out what you are storing.</h2>
        <p class="pitch">
          Free forever, open source, and built by a developer who got tired of running out of disk.
        </p>
        <p class="actions">
          <a class="button" href={SITE.download}>Download for macOS</a>
          <a class="button ghost" href={SITE.repo}>Read the source <span aria-hidden="true">↗</span></a>
        </p>
        <p class="meta">Notarized by Apple · No account · No telemetry · MIT licensed</p>
      </div>
    </section>
  </div>
</Base>

<style>
  .container {
    --section-gap: 128px;

    padding-top: 128px;
  }

  /* Hero */

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }

  h1 {
    margin-top: 28px;
    max-width: 15ch;
    font-family: var(--font-display);
    font-size: clamp(42px, 7.3vw, 76px);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .intro {
    display: flex;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 36px 56px;
    margin-top: 36px;
  }

  .lede {
    max-width: 52ch;
    font-size: 17px;
    color: var(--ink-2);
  }

  .actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
  }

  .meta {
    margin-top: 24px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--ink-3);
  }

  /* Illustrative app window */

  .window {
    margin-top: 72px;
    border: 1px solid var(--line);
    border-radius: 10px;
    overflow: hidden;
    background: var(--panel);
  }

  .chrome {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: 40px;
    padding: 0 16px;
    border-bottom: 1px solid var(--line-soft);
  }

  .dots {
    display: flex;
    gap: 7px;
  }

  .dots span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: rgb(244 244 242 / 14%);
  }

  .window-title {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--ink-3);
  }

  .window-body {
    display: flex;
    align-items: center;
    gap: 32px;
    padding: 28px;
  }

  .ring {
    position: relative;
    flex: none;
    width: 148px;
    height: 148px;
  }

  .ring svg {
    width: 100%;
    height: 100%;
    transform: rotate(-90deg);
  }

  .ring circle {
    fill: none;
    stroke: rgb(244 244 242 / 8%);
    stroke-width: 6;
  }

  .ring .arc {
    stroke: var(--accent);
    stroke-linecap: round;
    stroke-dasharray: 277;
    stroke-dashoffset: 62;
  }

  .total {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .gb {
    font-family: var(--font-display);
    font-size: 30px;
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .unit {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .tiles {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    flex: 1;
    min-width: 0;
    padding: 0;
    list-style: none;
    background: var(--line-soft);
    border: 1px solid var(--line-soft);
    border-radius: 8px;
    overflow: hidden;
  }

  .tiles li {
    background: var(--panel);
    padding: 14px 16px;
  }

  .tiles .name {
    display: block;
    overflow: hidden;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--ink-3);
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .tiles .size {
    display: block;
    margin-top: 6px;
    font-family: var(--font-display);
    font-size: 19px;
    font-weight: 500;
    letter-spacing: -0.015em;
  }

  .tiles .bar {
    display: block;
    height: 2px;
    margin-top: 10px;
    background: rgb(244 244 242 / 8%);
  }

  .tiles .bar::after {
    content: '';
    display: block;
    height: 100%;
    width: var(--share);
    background: var(--accent);
  }

  /* Section headings shared by coverage/safety/guarantees */

  h3 {
    font-family: var(--font-display);
    font-size: clamp(30px, 3.8vw, 40px);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -0.025em;
  }

  /* Coverage */

  .split {
    display: flex;
    flex-wrap: wrap;
    gap: 24px 56px;
    margin-top: 40px;
  }

  .split h3 {
    flex: 1;
    min-width: min(320px, 100%);
    max-width: 18ch;
  }

  .split p {
    flex: 1;
    min-width: min(320px, 100%);
    max-width: 46ch;
    margin-top: 4px;
    font-size: 15.5px;
    line-height: 1.65;
    color: var(--ink-2);
  }

  .coverage {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    margin-top: 48px;
    padding: 0;
    list-style: none;
    background: var(--line-soft);
    border: 1px solid var(--line-soft);
  }

  .coverage li {
    background: var(--bg);
    padding: 28px 26px 30px;
    transition: background 0.2s ease;
  }

  .coverage li:hover {
    background: var(--panel);
  }

  .coverage .num {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--ink-3);
  }

  .coverage .name {
    display: block;
    margin-top: 40px;
    font-family: var(--font-display);
    font-size: 19px;
    font-weight: 500;
    letter-spacing: -0.015em;
  }

  .coverage p {
    margin-top: 10px;
    font-size: 14px;
    color: var(--ink-2);
  }

  /* Safety */

  .safety {
    display: flex;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 40px 72px;
    margin-top: 40px;
  }

  .safety-copy {
    flex: 1;
    min-width: min(320px, 100%);
  }

  .safety-copy h3 {
    max-width: 16ch;
  }

  .safety-copy p {
    max-width: 46ch;
    margin-top: 20px;
    font-size: 15.5px;
    line-height: 1.65;
    color: var(--ink-2);
  }

  .ratings {
    flex: 1;
    min-width: min(360px, 100%);
    padding: 0;
    list-style: none;
  }

  .ratings li {
    display: flex;
    align-items: flex-start;
    gap: 20px;
    padding-block: 22px;
    border-top: 1px solid var(--line-soft);
  }

  .badge {
    flex: none;
    width: 110px;
    margin-top: 2px;
    font-family: var(--font-mono);
    font-size: 12.5px;
    font-weight: 500;
  }

  .badge.safe {
    color: var(--accent);
  }

  .badge.caution {
    color: oklch(80% 0.13 85);
  }

  .badge.destructive {
    color: oklch(72% 0.16 25);
  }

  .ratings p {
    flex: 1;
    font-size: 14px;
    color: var(--ink-2);
  }

  /* Guarantees */

  .nevers-title {
    margin-top: 40px;
  }

  .nevers {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    column-gap: 72px;
    margin-top: 36px;
    padding: 0;
    list-style: none;
  }

  .nevers li {
    display: flex;
    align-items: flex-start;
    gap: 20px;
    padding-block: 24px;
    border-top: 1px solid var(--line-soft);
  }

  .nevers .num {
    margin-top: 3px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--ink-3);
  }

  .nevers .name {
    display: block;
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .nevers p {
    margin-top: 7px;
    font-size: 14px;
    color: var(--ink-2);
  }

  /* Download */

  .download {
    margin-top: var(--section-gap);
    scroll-margin-top: 64px;
  }

  .download-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-block: 96px 8px;
    border-top: 1px solid var(--line);
    text-align: center;
  }

  .download h2 {
    margin-top: 32px;
    max-width: 18ch;
    font-family: var(--font-display);
    font-size: clamp(34px, 4.6vw, 48px);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .pitch {
    margin-top: 18px;
    max-width: 44ch;
    font-size: 15.5px;
    line-height: 1.65;
    color: var(--ink-2);
  }

  .download .actions {
    justify-content: center;
    margin-top: 32px;
  }

  .download .meta {
    margin-top: 26px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .ring .arc {
      animation: ring-draw 1.4s var(--ease-out) both;
    }

    @keyframes ring-draw {
      from {
        stroke-dashoffset: 240;
      }
    }
  }

  @media (width <= 920px) {
    .coverage {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (width <= 720px) {
    .window-body {
      flex-direction: column;
      align-items: flex-start;
    }

    .ring {
      align-self: center;
    }

    .tiles {
      grid-template-columns: repeat(2, 1fr);
      align-self: stretch;
    }

    .coverage,
    .nevers {
      grid-template-columns: 1fr;
    }
  }
</style>
