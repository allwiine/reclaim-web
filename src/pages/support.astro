---
import FaqItem from '../components/FaqItem.astro';
import NumberedSection from '../components/NumberedSection.astro';
import { SITE } from '../data/site';
import { channels, faqs, recovery } from '../data/support';
import Base from '../layouts/Base.astro';
---

<Base
  title="Support · Reclaim"
  description="How to get help with Reclaim, the free open-source Mac app that cleans wasted developer storage. Common questions, recovery steps and where to report a problem."
>
  <div class="container">
    <p class="label reveal" style="--i: 0">Support</p>
    <h1 class="reveal" style="--i: 1">Usually answered within a day.</h1>
    <p class="lede reveal" style="--i: 2">
      Reclaim is a one-person project. Everything goes through GitHub, and it reaches the developer
      directly.
    </p>

    <ul class="channels reveal" style="--i: 3" aria-label="Support channels">
      {
        channels.map(({ title, detail, action, href }) => (
          <li>
            <a href={href}>
              <span class="title">{title}</span>
              <span class="detail">{detail}</span>
              <span class="action">
                {action} <span aria-hidden="true">→</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    <NumberedSection index="01" title="Common questions">
      <div class="faqs">
        {faqs.map((faq, index) => <FaqItem {index} open={index === 0} {...faq} />)}
      </div>
    </NumberedSection>

    <NumberedSection index="02" title="If something went wrong">
      <ul class="recovery">
        {
          recovery.map(({ title, text }) => (
            <li>
              <h3>{title}</h3>
              <p>{text}</p>
            </li>
          ))
        }
      </ul>
    </NumberedSection>

    <section class="cta" aria-labelledby="still-stuck">
      <div>
        <h2 id="still-stuck">Still stuck?</h2>
        <p>
          Open an issue with your macOS version, your Reclaim version, and what you expected to
          happen. A screenshot of the scan helps.
        </p>
      </div>
      <a class="button" href={SITE.newIssue}>Open an issue</a>
    </section>
  </div>
</Base>

<style>
  .container {
    padding-top: 96px;
  }

  h1 {
    margin-top: 20px;
    font-family: var(--font-display);
    font-size: clamp(34px, 6vw, 52px);
    font-weight: 500;
    line-height: 1.02;
    letter-spacing: -0.03em;
  }

  .lede {
    margin-top: 20px;
    max-width: 56ch;
    font-size: 16.5px;
    color: var(--ink-2);
  }

  .channels {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    margin-top: 48px;
    padding: 0;
    list-style: none;
    background: var(--line-soft);
    border: 1px solid var(--line-soft);
  }

  .channels a {
    display: block;
    height: 100%;
    padding: 22px 22px 24px;
    background: var(--bg);
    transition: background 0.2s ease;
  }

  .channels a:hover {
    background: var(--panel);
  }

  .channels .title {
    display: block;
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .channels .detail {
    display: block;
    margin-top: 7px;
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--ink-2);
  }

  .channels .action {
    display: block;
    margin-top: 16px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--accent);
  }

  .faqs {
    margin-top: 32px;
  }

  .recovery {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    column-gap: 72px;
    margin-top: 12px;
    padding: 0;
    list-style: none;
  }

  .recovery li {
    padding-block: 24px;
    border-bottom: 1px solid var(--line-soft);
  }

  .recovery h3 {
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .recovery p {
    margin-top: 8px;
    font-size: 14px;
    color: var(--ink-2);
  }

  .cta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 32px;
    margin-top: 96px;
    padding-top: 48px;
    border-top: 1px solid var(--line);
  }

  .cta > div {
    flex: 1;
    min-width: 300px;
  }

  .cta h2 {
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .cta p {
    margin-top: 8px;
    max-width: 60ch;
    font-size: 14.5px;
    color: var(--ink-2);
  }

  @media (width <= 720px) {
    .channels,
    .recovery {
      grid-template-columns: 1fr;
    }
  }
</style>
