---
import { sections, shorts } from '../data/privacy';
import { SITE } from '../data/site';
import Base from '../layouts/Base.astro';
---

<Base
  title="Privacy · Reclaim"
  description="Reclaim runs entirely on your Mac: no server, no account system, no analytics. The only network request is an optional update check, and it can be turned off."
  maxWidth={800}
>
  <div class="container">
    <p class="label reveal" style="--i: 0">Privacy · Last updated 7 August 2026</p>
    <h1 class="reveal" style="--i: 1">Nothing leaves your Mac.</h1>
    <p class="lede reveal" style="--i: 2">
      Reclaim runs entirely on your Mac. It has no server, no account system and no analytics.
      Nothing about your machine, your projects or your usage is transmitted anywhere.
    </p>

    <section class="in-short reveal" style="--i: 3" aria-labelledby="in-short">
      <h2 class="label" id="in-short">In short</h2>
      <ul>
        {
          shorts.map((item) => (
            <li>
              <span class="check" aria-hidden="true">✓</span>
              {item}
            </li>
          ))
        }
      </ul>
    </section>

    {
      sections.map(({ title, paras }, i) => (
        <section class="policy" aria-labelledby={`policy-${i + 1}`}>
          <span class="num" aria-hidden="true">{`0${i + 1}`}</span>
          <div>
            <h2 id={`policy-${i + 1}`}>{title}</h2>
            {paras.map((para) => (
              <p>{para}</p>
            ))}
          </div>
        </section>
      ))
    }

    <section class="contact" aria-labelledby="questions">
      <h2 id="questions">Questions about any of this</h2>
      <p>
        Open an issue or discussion on <a href={SITE.repo}>GitHub</a>. A person answers.
      </p>
    </section>
  </div>
</Base>

<style>
  .container {
    padding-top: 96px;
  }

  h1 {
    margin-top: 20px;
    max-width: 18ch;
    font-family: var(--font-display);
    font-size: clamp(34px, 6vw, 52px);
    font-weight: 500;
    line-height: 1.02;
    letter-spacing: -0.03em;
  }

  .lede {
    margin-top: 20px;
    max-width: 56ch;
    font-size: 16.5px;
    color: var(--ink-2);
  }

  .in-short {
    margin-top: 48px;
    padding: 24px 28px;
    border: 1px solid var(--line-soft);
    border-radius: 8px;
    background: var(--panel);
  }

  .in-short ul {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 16px;
    padding: 0;
    list-style: none;
  }

  .in-short li {
    display: flex;
    align-items: baseline;
    gap: 14px;
    font-size: 14.5px;
    line-height: 1.55;
  }

  .check {
    flex: none;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--accent);
  }

  .policy {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 16px 24px;
    margin-top: 64px;
    padding-top: 28px;
    border-top: 1px solid var(--line-soft);
  }

  .policy .num {
    flex: none;
    width: 22px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--ink-3);
  }

  .policy div {
    flex: 1;
    min-width: min(300px, 100%);
  }

  .policy h2 {
    font-family: var(--font-display);
    font-size: 23px;
    font-weight: 500;
    letter-spacing: -0.015em;
  }

  .policy p {
    max-width: 64ch;
    margin-top: 14px;
    font-size: 15px;
    line-height: 1.7;
    color: var(--ink-2);
  }

  .contact {
    margin-top: 72px;
    padding-top: 40px;
    border-top: 1px solid var(--line);
  }

  .contact h2 {
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 500;
    letter-spacing: -0.015em;
  }

  .contact p {
    margin-top: 6px;
    font-size: 14.5px;
    color: var(--ink-2);
  }

  .contact a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
